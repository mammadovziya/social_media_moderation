# OpenAI

OPENAI_CUSTOM_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_SERVICE_TIER=default
OPENAI_CLASSIFICATION_IMAGE_DETAIL=high
OPENAI_ADJUDICATION_IMAGE_DETAIL=original
OPENAI_PROMPT_CACHE_KEY_ENABLED=true
OPENAI_MAX_CONNECTIONS=32
OPENAI_MAX_CONNECTIONS_PER_ROUTE=32
OPENAI_CONNECTION_REQUEST_TIMEOUT_MILLIS=500
OPENAI_IDLE_CONNECTION_EVICT_SECONDS=30
OPENAI_MAX_CONCURRENT_REQUESTS=32
OPENAI_MAX_CONCURRENT_REQUESTS_PER_MODEL=16
OPENAI_MAX_QUEUED_REQUESTS=64
OPENAI_ADMISSION_TIMEOUT_MILLIS=250
MODERATION_SCORE_BLOCK_THRESHOLD=0.15

# Gateway upstream connection pool and end-of-request persistence reserve.
MODERATION_FINALIZATION_RESERVE_MS=3000
GATEWAY_HTTP_MAX_CONNECTIONS=128
GATEWAY_HTTP_MAX_CONNECTIONS_PER_ROUTE=64
GATEWAY_HTTP_CONNECTION_REQUEST_TIMEOUT_MS=1000
GATEWAY_HTTP_CONNECT_TIMEOUT_MS=3000
GATEWAY_HTTP_KEEP_ALIVE_SECONDS=30
GATEWAY_HTTP_IDLE_CONNECTION_EVICT_SECONDS=30

# Local image-analysis admission and complete-result cache. Tune only from
# measured CPU, heap, and cache hit-rate data.
MEDIA_ANALYSIS_MAX_CONCURRENT=4
MEDIA_PDQ_MAX_CONCURRENT=2
MEDIA_ACQUIRE_TIMEOUT_MILLIS=30000
MEDIA_RESULT_CACHE_MAX_ENTRIES=512
MEDIA_RESULT_CACHE_TTL_SECONDS=3600

# Optional: set and export this value when running governed local benchmarks.
MODERATION_INTERNAL_RESPONSE_TOKEN=

# Local-only opt-in. Production must set one shared 43+ character token on the
# gateway and media service and set this flag to false.
AI_WORK_IDEMPOTENCY_INTERNAL_TOKEN=
AI_WORK_IDEMPOTENCY_ALLOW_UNAUTHENTICATED=true

# Local policy distribution. Production must use a distinct shared 43+
# character token, HTTPS, and set both override flags to false.
BLOCKED_TERMS_SOURCE_MODE=file
BLOCKED_TERMS_REFRESH_INTERVAL_MS=30000
BLOCKED_TERMS_FETCH_TIMEOUT_MS=2000
BLOCKED_TERMS_MAX_STALE_SECONDS=900
POLICY_DISTRIBUTION_INTERNAL_TOKEN=
POLICY_DISTRIBUTION_ALLOW_UNAUTHENTICATED=true
POLICY_DISTRIBUTION_ALLOW_INSECURE_HTTP=true

# Database
POSTGRES_DB=moderation
POSTGRES_USER=moderation
POSTGRES_PASSWORD=change-this-password
