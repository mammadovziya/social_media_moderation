GATEWAY_PORT=8080

# Provider access is disabled by default. Deterministic SHA/term paths remain
# testable offline; AI-required requests return UNKNOWN until both the explicit
# switch and a key are configured after spend approval.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=60
OPENAI_TERRA_REASONING_EFFORT=medium
OPENAI_MAX_CONCURRENT_REQUESTS=4

# The three model IDs are intentionally hard-coded in the application:
# omni-moderation-latest, gpt-4o-mini and gpt-5.6-terra.

MAX_IMAGE_BYTES=8388608
MAX_IMAGE_REQUEST_BYTES=9437184
MAX_IMAGE_WIDTH=8192
MAX_IMAGE_HEIGHT=8192
MAX_IMAGE_PIXELS=40000000

MODERATION_POLICY_VERSION=minimal-sha-ai-v1
