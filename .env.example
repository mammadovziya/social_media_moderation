GATEWAY_PORT=8080

# OpenAI
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_CUSTOM_MODEL=gpt-4o-mini

# Database for PDQ hashes
POSTGRES_DB=moderation
POSTGRES_USER=moderation
POSTGRES_PASSWORD=change-this-password

# PDQ match limits
PDQ_DISTANCE_THRESHOLD=31
PDQ_QUALITY_THRESHOLD=49

# Scores at or above this threshold return UNKNOWN when not already blocked.
MODERATION_UNKNOWN_THRESHOLD=0.70

# Image limits
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
UPSTREAM_TIMEOUT_SECONDS=30
