GATEWAY_PORT=8080

# OpenAI
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_MODERATION_PROFILE_SHA256=0e9e994cef268f7a1437292c34b9b53a932ba64fc1c5e49f8eb1a9336a73f0fa
OPENAI_CUSTOM_MODEL=gpt-4o-mini
OPENAI_CLASSIFICATION_PROMPT_BUNDLE_SHA256=7b0ea4271fe59577592561ce2e2b177df7427d5419c6eaca1f53a10452d097cd
OPENAI_CLASSIFICATION_PROFILE_SHA256=67699dacd5fd8919367dcaacf7687404f820d638dbfc9efbf74a0b4c04c68fc8
OPENAI_ADJUDICATION_MODEL=gpt-5.6-terra
OPENAI_ADJUDICATION_PROMPT_SHA256=b066ec4efc4af83b6a477f3ca496ccddc716bfe84ffd4a6f5ff523a5468f6f29
OPENAI_ADJUDICATION_PROFILE_SHA256=06fcc036b886a71c2fd2ceae32bbbade6fa8cd0fd964cd29868073c0c6a91f81
OPENAI_ADJUDICATION_REASONING_EFFORT=medium
OPENAI_TIMEOUT_SECONDS=30

# Database for references, evidence and audit metadata
POSTGRES_DB=moderation
POSTGRES_USER=moderation
POSTGRES_PASSWORD=change-this-password

# PDQ match limits
PDQ_DISTANCE_THRESHOLD=31
PDQ_QUALITY_THRESHOLD=49
PDQ_CANDIDATE_LIMIT=5

# Scores at or above this threshold return UNKNOWN when not already blocked.
MODERATION_UNKNOWN_THRESHOLD=0.70

# Versioned cross-service image limits. Startup rejects values above 8 MiB per
# file, 9 MiB per multipart request, or 16,777,216 decoded pixels.
MAX_IMAGE_BYTES=8388608
MAX_IMAGE_REQUEST_BYTES=9437184
MAX_IMAGE_PIXELS=16777216

# Required by the local text-dependent image demo.
OCR_ENABLED=true
OCR_LANGUAGES=aze+eng+rus+tur
OCR_TIMEOUT_SECONDS=10
OCR_MAX_TEXT_CHARS=20000
OCR_MAX_SPANS=256
OCR_MIN_CONFIDENCE=45.0
OCR_MAX_CONCURRENT=2

# Local Compose explicitly permits unauthenticated visual retrieval. Production
# must set this false and provide the same 32+ character token to both services.
VISUAL_RETRIEVAL_ALLOW_UNAUTHENTICATED=true
VISUAL_RETRIEVAL_INTERNAL_TOKEN=
VISUAL_DESCRIPTOR_VERSION=opencv-orb-4.12-v1
VISUAL_CANDIDATE_SELECTION_VERSION=orb-homography-specificity-v1
VISUAL_CANDIDATE_LIMIT=5
VISUAL_CONNECT_TIMEOUT_MILLIS=500
VISUAL_READ_TIMEOUT_MILLIS=30000
VISUAL_MAX_REFERENCES=256
VISUAL_MAX_SNAPSHOT_BYTES=67108864

UPSTREAM_TIMEOUT_SECONDS=45
